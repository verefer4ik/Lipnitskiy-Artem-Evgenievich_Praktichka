задание 4

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Задание 4</title>
</head>
<body>

    <p id="paragraph">Этот текст исчезнет, если нажать на кнопку ниже.</p>

    <button id="delete">Удалить текст</button>

    <script>
        let paragraph = document.querySelector("#paragraph");
let deleteButton = document.querySelector("#delete");

deleteButton.addEventListener("click", function() {
    paragraph.remove();
});
</script>

</body>
</html>

задание 5

 <!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Задание 5</title>
    <style>
        .delete-btn {
            margin-left: 10px;
            color: red;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <h1>Мой список дел</h1>
    
    <input type="text" id="todoInput" placeholder="Введите задачу...">
    <button id="addBtn">Добавить</button>

    <p>Всего задач: <span id="counter">0</span></p>

    <ul id="todoList"></ul>

    <script>
let todoInput = document.querySelector("#todoInput");
let addBtn = document.querySelector("#addBtn");
let todoList = document.querySelector("#todoList");
let counter = document.querySelector("#counter");

function updateCounter() {
    let totalItems = todoList.querySelectorAll("li").length;
    counter.textContent = totalItems;
}

addBtn.addEventListener("click", function() {
    let taskText = todoInput.value.trim();

    if (taskText === "") {
        alert("Пожалуйста, введите текст задачи!");
        return;
    }

    let li = document.createElement("li");
    li.textContent = taskText;

    let deleteBtn = document.createElement("button");
    deleteBtn.textContent = "Стереть с лица земли!";
    deleteBtn.classList.add("delete-btn");

    deleteBtn.addEventListener("click", function() {
        li.remove();
        updateCounter();
    });

    li.append(deleteBtn);
    todoList.append(li);

    todoInput.value = "";
    updateCounter();
});

    </script>
</body>
</html>

задание 6

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Задание 6</title>
</head>
<body>

    <h1>Задание 6</h1>
    <p>Результат работы программы выводится в консоль разработчика.</p>
    <p> --> F12 --> Консоль 

    <script>
const student1 = { name: 'Алина', group: 'ВЕБ-21' };
const student2 = { name: 'Максим', group: 'ВЕБ-22' };

function showInfo() {
    console.log(this.name, this.group);
}

student1.showInfo = showInfo;
student2.showInfo = showInfo;

console.log("--- Вызов методов объектов ---");
student1.showInfo();
student2.showInfo();

console.log("--- Вызов отдельной переменной ---");
const copiedShowInfo = student1.showInfo;
copiedShowInfo();
    </script>

</body>
</html>

задание 7

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Задание 7</title>
</head>
<body>

    <h1>Задание 7</h1>
    <p><strong>Так же, F12 и консоль</p>

    <script>
const product = { name: 'Наушники', price: 5000 };

function showProduct(discount, city) {
    const finalPrice = this.price * (1 - discount / 100);
    
    console.log(Товар: ${this.name}, Цена со скидкой: ${finalPrice} руб., Город доставки: ${city});
}

console.log("--- call() ---");
showProduct.call(product, 10, 'Москва'); 

console.log("--- apply() ---");
showProduct.apply(product, [20, 'Санкт-Петербург']); 
</script>

</body>
</html>

задание 8

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Задание 8</title>
</head>
<body>

    <h1>Задание 8</h1>
    <p>F12. Там все ответы</p>

    
    <script>
      
const employee = {
    name: 'Дмитрий',
    position: 'Веб-разработчик',
    showInfo() {
        console.log(this.name, this.position);
    }
};

console.log("--- Вызов метода ---");
employee.showInfo();

console.log("--- Вызов из переменной ---");
const stolenShowInfo = employee.showInfo;
stolenShowInfo();

const boundShowInfo = employee.showInfo.bind(employee);

console.log("--- bind функции ---");
boundShowInfo();

console.log("--- Доп. задание (второй сотрудник) ---");
const employee2 = {
    name: 'Елена',
    position: 'Дизайнер'
};

const boundShowInfo2 = employee.showInfo.bind(employee2);
boundShowInfo2();

    </script>

</body>
</html>

задание 9

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Задание 9</title>
</head>
<body>

    <h1>Задание 9</h1>
    
    <button id="regular">Обычная функция</button>
    <button id="arrow">Стрелочная функция</button>

    <p>Ответ в консоле</p>

    
    <script>
const regularBtn = document.querySelector('#regular');
const arrowBtn = document.querySelector('#arrow');

regularBtn.addEventListener('click', function(event) {
    console.log('--- Тык по обычной функции ---');
    console.log('this:', this); 
    console.log('event.currentTarget:', event.currentTarget);
});

arrowBtn.addEventListener('click', (event) => {
    console.log('--- Тык по стрелочной функции ---');
    console.log('this:', this); 
    console.log('event.currentTarget:', event.currentTarget);
});
/*
В обычной функции this определяется в момент вызова. При срабатывании DOM-события браузер автоматически связывает this с элементом, на котором оно произошло.

В стрелочной функции своего собственого контекста thid нету. Стрелочная функция замыкает тот this, который окружал её в момент создания.
*/

</script>
    
</body>
</html>

10 задание (дз)

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>ДЗ</title>
</head>
<body>

    <h1>ДЗ</h1>
    <p>Как всегда, все ответы в консоле</p>
    
    <button id="action-btn">Нажми на меня</button>

    <script>
        const employee = {
    name: 'Иван Петров',
    position: 'Фронтенд-разработчик',
    department: 'Департамент IT',
    
    showCard() {
        console.log(Сотрудник: ${this.name}, Должность: ${this.position}, Отдел: ${this.department});
    }
};

console.log("--- Вызов как метод объекта ---");
employee.showCard();
//При вызове метода через точку (employee.showCard()) контекст this автоматически ссылается на объект перед точкой (employee) 


console.log("--- Вызов из переменной ---");
const stolenShowCard = employee.showCard;
stolenShowCard(); 
// Функция вызывается без привязки к объекту, поэтому this теряет связь с employee и начинает ссылаться на глобальный объект window.

console.log("--- Фикс через bind() ---");
const fixedShowCard = employee.showCard.bind(employee);
fixedShowCard();
//Метод bind создает новую функцию и привязывается к ней объект employee в качестве this.

function showCardInCity(city) {
    console.log(Сотрудник: ${this.name}, Должность: ${this.position}, Город: ${city});
}

console.log("--- Вызов внешней функции через call() ---");
showCardInCity.call(employee, 'Москва');

console.log("--- Вызов внешней функции через apply() ---");
showCardInCity.apply(employee, ['Санкт-Петербург']);
//Методы this() и call() вызывают функцию мгновенно, подменяя ее this на переданный объект


const btn = document.querySelector('#action-btn');

btn.addEventListener('click', function(event) {
    console.log("--- Обычная функция в событии ---");
    console.log("this указывает на:", this); 
    console.log("event.currentTarget указывает на:", event.currentTarget);
});

btn.addEventListener('click', (event) => {
    console.log("--- Пункт 7: Стрелочная функция в событии ---");
    console.log("this указывает на:", this); 
    console.log("event.currentTarget указывает на:", event.currentTarget);
});
//В обычном обработчике this указывает на элемент, вызвавший событие, а у стрелочной функции своего this нет. Использование event.currentTarget безопасно и всегда ссылается на целевой элемент в обоих случаях.

    </script>
</body>
</html>
