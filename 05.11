задание 1

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Практика №3</title>
</head>
<body>

    <h1 id="title">Старый заголовок</h1>
    <p id="description">Старое описание</p>
    <button id="change">Изменить текст</button>

    <script>
      const titleElement = document.getElementById('title');
const descriptionElement = document.getElementById('description');
const buttonElement = document.getElementById('change');

buttonElement.addEventListener('click', () => {
    titleElement.textContent = 'Добро пожаловать!';
    
    descriptionElement.textContent = 'Мы изучаем JavaScript и DOM';
});
    </script>
</body>
</html>

задание 2

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Задание 2</title>
</head>
<body>

    <h1 id="heading">Привет, это тестовый заголовок!</h1>

    <button id="color">Изменить цвет текста</button>

    <button id="background">Изменить фон страницы</button>

    <script>
        let heading = document.querySelector("#heading");

        const textColors = ["red", "blue", "green", "orange", "purple", "brown"];
        const bgColors = ["pink", "lightblue", "lightgreen", "lightyellow", "lavender", "thistle"];

        let textColorIndex = 0;
        let bgColorIndex = 0;

        document.querySelector("#color").addEventListener("click", function() {
            heading.style.color = textColors[textColorIndex];
            
            textColorIndex = (textColorIndex + 1) % textColors.length;
        });

        document.querySelector("#background").addEventListener("click", function() {
            let randomIndex = Math.floor(Math.random() * bgColors.length);
            document.body.style.backgroundColor = bgColors[randomIndex];
        });
    </script>
</body>
</html>

задание 3

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Задание 3</title>
</head>
<body>

    <h1>Мои навыки</h1>
    
    <ul id="skills"></ul>

    <script>
let skills = document.querySelector("#skills");

let item1 = document.createElement("li");
item1.textContent = "HTML";

let item2 = document.createElement("li");
item2.textContent = "CSS";

let item3 = document.createElement("li");
item3.textContent = "JavaScript";

skills.append(item1, item2, item3);

    </script>
    
</body>
